<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu baris daftar aplikasi: [centang] [ikon huruf] [nama + detail] [▲] [▼] [✕].
  Warna lingkaran ikon diisi dari kode (Shortcut.color) — tanpa aset gambar per aplikasi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <CheckBox
        android:id="@+id/row_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/row_toggle" />

    <TextView
        android:id="@+id/row_badge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="2dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:textColor="@color/brand_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/brand_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/brand_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_up"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:contentDescription="@string/row_move_up"
        android:gravity="center"
        android:text="▲"
        android:textColor="@color/brand_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/row_down"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:contentDescription="@string/row_move_down"
        android:gravity="center"
        android:text="▼"
        android:textColor="@color/brand_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/row_remove"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:contentDescription="@string/row_remove"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/brand_muted"
        android:textSize="13sp" />
</LinearLayout>
