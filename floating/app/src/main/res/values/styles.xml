<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AsProjectFloating" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:colorAccent">@color/brand_gold</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="BrandButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="BrandButtonGhost" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/brand_text</item>
    </style>

    <!-- Judul kartu pada layar pengaturan. -->
    <style name="CardTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_gold_deep</item>
    </style>
</resources>
