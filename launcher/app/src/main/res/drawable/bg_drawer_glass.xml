<?xml version="1.0" encoding="utf-8"?>
<!-- Panel laci aplikasi: kaca cair gelap dengan tepi atas terang (rim light). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
            <solid android:color="#F20A1018" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
            <gradient
                android:angle="270"
                android:endColor="#00070B12"
                android:startColor="#40243033"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#4DBFEFFF" />
        </shape>
    </item>
</layer-list>
