<?xml version="1.0" encoding="utf-8"?>
<!--
  Chip kaca cair: dasar gelap tembus pandang, sapuan terang di bagian atas
  (sorotan kaca), lalu garis tepi neon sebagai rim light.
  Dipakai chip status di layar kunci agar senada dengan LiquidBatteryView.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#9904070B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#38E8FBFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#99BFEFFF" />
        </shape>
    </item>
</layer-list>
