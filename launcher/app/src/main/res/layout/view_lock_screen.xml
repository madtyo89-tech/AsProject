<?xml version="1.0" encoding="utf-8"?>
<!--
  Isi layar kunci. Di-inflate ke dalam LockScreenView (FrameLayout) sehingga
  memakai <merge>. Wallpaper memakai mode CONTAIN agar bingkai liquid-chrome
  tidak terpotong di layar dengan rasio berbeda.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <my.id.asproject.launcher.LockWallpaperView
        android:id="@+id/lockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lock_scrim" />

    <LinearLayout
        android:id="@+id/lockContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="BATERAI 74%"
                android:textColor="@color/neon_soft"
                android:textSize="9sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/lock_chip_status"
                android:textColor="@color/neon_soft"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lockLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.42"
            android:text="@string/lock_label"
            android:textColor="@color/neon_dim"
            android:textSize="10sp" />

        <TextClock
            android:id="@+id/lockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:shadowColor="#AA4FC3F7"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="26"
            android:textColor="@color/text_primary"
            android:textSize="78sp" />

        <TextView
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.06"
            android:shadowColor="#88000000"
            android:shadowRadius="8"
            android:textColor="@color/neon_soft"
            android:textSize="13sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            android:tint="@color/neon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="@string/lock_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_up"
            android:tint="@color/neon"
            android:alpha="0.85" />

        <View
            android:id="@+id/lockHandle"
            android:layout_width="96dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_lock_handle" />
    </LinearLayout>
</merge>
