<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/gold_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_wallpaper" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/lock_label"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wallpaper_lock_thumb" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/section_wallpaper"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wallpaper_home_thumb" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/wallpaper_note"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <Switch
                android:id="@+id/switchWallpaper"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_figure_wallpaper" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_accent" />

            <RadioGroup
                android:id="@+id/accentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/accentBiru"
                    style="@style/AccentChoice"
                    android:buttonTint="@color/accent_biru"
                    android:text="@string/accent_biru" />

                <RadioButton
                    android:id="@+id/accentHijau"
                    style="@style/AccentChoice"
                    android:buttonTint="@color/accent_hijau"
                    android:text="@string/accent_hijau" />

                <RadioButton
                    android:id="@+id/accentUngu"
                    style="@style/AccentChoice"
                    android:buttonTint="@color/accent_ungu"
                    android:text="@string/accent_ungu" />

                <RadioButton
                    android:id="@+id/accentPink"
                    style="@style/AccentChoice"
                    android:buttonTint="@color/accent_pink"
                    android:text="@string/accent_pink" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accent_note"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_lock" />

            <Switch
                android:id="@+id/switchLock"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_lock_screen" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_note"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_icons" />

            <Switch
                android:id="@+id/switchNeon"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_neon_icons" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/neon_note_all"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_motion" />

            <Switch
                android:id="@+id/switchMotion"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/liquid_motion" />

            <Switch
                android:id="@+id/switchHud"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hud_animation" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/motion_note"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_slidebar" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button"
                android:padding="4dp">

                <my.id.asproject.launcher.LiquidHandleView
                    android:id="@+id/slideBarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <RadioGroup
                android:id="@+id/slideBarGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <RadioButton
                    android:id="@+id/styleOmbak"
                    style="@style/SlideBarChoice"
                    android:text="@string/slide_bar_ombak" />

                <RadioButton
                    android:id="@+id/stylePil"
                    style="@style/SlideBarChoice"
                    android:text="@string/slide_bar_pil" />

                <RadioButton
                    android:id="@+id/styleTitik"
                    style="@style/SlideBarChoice"
                    android:text="@string/slide_bar_titik" />

                <RadioButton
                    android:id="@+id/styleSirkuit"
                    style="@style/SlideBarChoice"
                    android:text="@string/slide_bar_sirkuit" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/slide_bar_note"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_appearance" />

            <Switch
                android:id="@+id/switchClock"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_clock" />

            <Switch
                android:id="@+id/switchSearch"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_search" />

            <Switch
                android:id="@+id/switchLabels"
                style="@style/SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_labels" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_grid" />

            <RadioGroup
                android:id="@+id/columnsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/column4"
                    style="@style/ColumnChoice"
                    android:text="4" />

                <RadioButton
                    android:id="@+id/column5"
                    style="@style/ColumnChoice"
                    android:text="5" />

                <RadioButton
                    android:id="@+id/column6"
                    style="@style/ColumnChoice"
                    android:text="6" />
            </RadioGroup>

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_dock" />

            <Button
                android:id="@+id/resetDock"
                style="@style/SettingsButton"
                android:text="@string/reset_dock" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_hidden" />

            <Button
                android:id="@+id/pickHidden"
                style="@style/SettingsButton"
                android:text="@string/pick_hidden" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_about" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold_soft"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_body"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
