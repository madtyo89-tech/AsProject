<?xml version="1.0" encoding="utf-8"?>
<!--
  AsProject Launcher — pengganti layar beranda Android.

  Launcher ini TIDAK meminta izin jaringan, kontak, mikrofon, kamera, SMS,
  maupun penyimpanan. Satu-satunya pengecualian adalah fitur OPSIONAL
  "Spidometer mengambang" (nonaktif secara bawaan, lihat SpeedometerService):
  untuk bisa menampilkan bubble kecepatan di atas aplikasi lain tanpa meredup
  layar, Android mewajibkan izin Lokasi, "Gambar di atas aplikasi lain", dan
  notifikasi layanan latar depan. Izin-izin ini baru diminta saat pengguna
  menyalakan sakelarnya sendiri di Pengaturan → Spidometer mengambang.

  Atribut `package` dan <uses-sdk> sengaja tidak ditulis:
    • Gradle memakai namespace/applicationId/minSdk/targetSdk dari app/build.gradle;
    • build tanpa Gradle menyuntikkannya lewat android/buildkit/build-apk.sh.

  <queries> diperlukan sejak Android 11 (API 30) agar peluncur tetap bisa melihat
  aplikasi lain meski aturan keterlihatan paket berlaku.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dipakai HANYA oleh fitur opsional "Spidometer mengambang". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_WALLPAPER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".AsProjectApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AsProjectLauncher">

        <!--
          Kategori HOME + DEFAULT membuat aplikasi ini muncul di daftar
          "Aplikasi beranda" pada Pengaturan Android. Kategori LAUNCHER membuatnya
          juga bisa dibuka seperti aplikasi biasa dari peluncur mana pun.
        -->
        <!--
          SEMENTARA UNTUK DIAGNOSIS ANR: activity beranda lengkap
          (LauncherActivity, dengan wallpaper liquid/HUD/widget/dll) TIDAK
          didaftarkan sebagai HOME di build diagnosis ini: lihat
          MinimalLauncherActivity di bawah untuk kenapa dan apa gantinya.
          Kelasnya tetap ada (tidak dihapus) supaya gampang dikembalikan
          begitu penyebab macetnya ketemu.
        -->
        <activity
            android:name=".LauncherActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Kategori HOME + DEFAULT membuat aplikasi ini muncul di daftar
          "Aplikasi beranda" pada Pengaturan Android. Kategori LAUNCHER membuatnya
          juga bisa dibuka seperti aplikasi biasa dari peluncur mana pun.

          Build diagnosis: beranda SUPER POLOS (tanpa wallpaper/animasi/widget/
          ikon neon/spidometer sama sekali): lihat MinimalLauncherActivity
          untuk alasannya. Begitu macetnya ketemu penyebabnya, kategori-kategori
          ini dikembalikan ke LauncherActivity di atas.
        -->
        <activity
            android:name=".MinimalLauncherActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.AsProjectLauncher.Settings" />

        <!--
          Layanan latar depan opsional untuk bubble "Spidometer mengambang".
          Hanya berjalan saat pengguna menyalakannya sendiri di Pengaturan
          dan semua izin terkait (Lokasi + overlay) sudah diberikan.
        -->
        <service
            android:name=".SpeedometerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
